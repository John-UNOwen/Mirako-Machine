config/*.json
# Per-instance configs: whole configs, so they carry device ids, borrow cards and
# skill lists. config/*.json above does not reach into a subdirectory.
config/instances/

# Atomic-write temp files: core/atomic_write.py names its per-writer scratch
# files *.tmp (e.g. config.json.<rand>.tmp in the repo root) and core/updates.py
# writes {cache}.{pid}.tmp. Only the config writers' temporaries hold FULL config
# snapshots -- device ids and all; the schedule and update-cache ones hold only
# their own (small, no-identity) payloads. A leftover from a killed write must
# never reach the public repo via a stray git add -A.
*.tmp

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist_ssr
*.local

