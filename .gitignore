.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore everything under notifications
assets/notifications/*

# But keep these specific sound effects
!assets/notifications/harikitte_ikou.mp3
!assets/notifications/sfx_01.mp3
!assets/notifications/sfx_02.mp3
!assets/notifications/sfx_03.mp3

# Windows thumbnail caches. Explorer regenerates these in any folder holding images,
# so they kept turning up as modified alongside real asset and reference changes.
Thumbs.db
ehthumbs.db
Desktop.ini

# Per-career run history. User data, and it grows -- see core/independent_stats.py.
stats/

# Local Claude Code settings, not project config.
.claude/

# Per-run vision scratch: the vision router's working directory at the repo root,
# regenerated on demand and never part of the project.
.dsh-vision-router/
# Timestamped config backups.
config.json.bak-*

# Development reference: screen captures the devtools suites verify behaviour
# against, defect captures, and the reference calculator the scoring was ported
# from. Nothing at runtime reads it, it is 160MB of private game captures, and
# each developer's own captures are what their devtools runs need. Kept on disk,
# out of the repo.
references/
